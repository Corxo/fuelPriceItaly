{
    "compilerOptions": {
      "target": "es6",                
      "module": "commonjs",              
      "strict": true,                    
      "esModuleInterop": true,           
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "outDir": "./dist",                
      "rootDir": ".",
      "noImplicitAny": false
    },
    "include": ["."],                  
    "exclude": ["node_modules", "dist"]  
  }
  